#!/bin/sh
export PKG_CONFIG_PATH=/usr/lib64/pkgconfig:/usr/lib/pkgconfig:/usr/share/pkgconfig
# xkbregistry was off at first to avoid pulling in libxml2, since a compositor
# does not need it. waybar does require it, so libxml2 is packaged now and the
# registry is built.
meson setup build \
    --prefix=/usr \
    --libdir=/usr/lib \
    -Denable-docs=false \
    -Denable-xkbregistry=true \
    -Dbuildtype=release
ninja -C build
DESTDIR="$1" ninja -C build install
