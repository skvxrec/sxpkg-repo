#!/bin/sh
# Option names are the ones seatd 0.8 actually defines; "logind"/"libseat" do
# not exist and made meson bail out. logind is off (this system is OpenRC), and
# man-pages defaults to auto, which would require scdoc.
meson setup build --prefix=/usr --libdir=/usr/lib \
  -Dlibseat-logind=disabled \
  -Dlibseat-seatd=enabled \
  -Dlibseat-builtin=enabled \
  -Dserver=enabled \
  -Dexamples=disabled \
  -Dman-pages=disabled
ninja -C build
DESTDIR="$1" ninja -C build install

# Upstream ships no OpenRC service, and a compositor started by a display
# manager runs as a normal user, so it needs the seatd daemon to hand out DRM
# and input devices.
install -dm755 "$1/etc/init.d"
cat > "$1/etc/init.d/seatd" <<'EOF'
#!/sbin/openrc-run

description="Seat management daemon"

command="/usr/bin/seatd"
# No "-g video" here: this system has only the root user and the root group, so
# seatd would refuse to start on a missing group. Once a normal user exists,
# create a video group and add -g video back.
command_background="yes"
pidfile="/run/seatd.pid"

depend()
{
	need devfs
	before ly
}
EOF
chmod 755 "$1/etc/init.d/seatd"
