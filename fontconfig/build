#!/bin/sh
# Upstream's release mirror stopped at 2.16, and pango needs >= 2.17, so this
# comes from the gitlab archive instead. That is a git snapshot with no
# generated configure script — fontconfig builds with meson these days anyway.
export PKG_CONFIG_PATH=/usr/lib64/pkgconfig:/usr/lib/pkgconfig:/usr/share/pkgconfig
meson setup build --wrap-mode=nofallback --prefix=/usr --libdir=/usr/lib \
    --sysconfdir=/etc --localstatedir=/var \
    -Dbuildtype=release \
    -Ddoc=disabled \
    -Dtests=disabled \
    -Dtools=enabled
ninja -C build
DESTDIR="$1" ninja -C build install
